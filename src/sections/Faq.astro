---
import Icon from '~/components/Icon.astro';
import { t, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<section class="section" aria-labelledby="faq-h">
  <div class="wrap faq__grid">
    <div class="section-head reveal faq__head">
      <p class="eyebrow">{d.faq.eyebrow}</p>
      <h2 class="h2" id="faq-h">{d.faq.heading}</h2>
    </div>

    <div class="faq__list">
      {d.faq.items.map((item, i) => (
        <details class="faq reveal" name="faq" style={`--reveal-delay:${i * 55}ms`}>
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__mark" aria-hidden="true"><Icon name="chevron" size={20} /></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
<set:html value={`<script type="application/ld+json">${JSON.stringify(faqSchema)}</script>`} />

<style>
  .faq__grid {
    display: grid; gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr; align-items: start;
  }
  @media (min-width: 980px) { .faq__grid { grid-template-columns: 0.8fr 1fr; } }
  .faq__head { margin-bottom: 0; }
  @media (min-width: 980px) { .faq__head { position: sticky; top: 7rem; } }

  .faq__list { border-top: 1px solid var(--line); }

  .faq { border-bottom: 1px solid var(--line); }
  .faq__q {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
    padding: 1.2rem 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    font-weight: 600; letter-spacing: -0.01em; line-height: 1.4;
    transition: color 0.22s var(--ease);
  }
  :global(html[lang^='ko']) .faq__q { font-weight: 700; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--brass-ink); }

  .faq__mark {
    flex: none; display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 50%;
    border: 1px solid var(--line); color: var(--text-2);
    transition: transform 0.32s var(--ease), background 0.24s var(--ease),
                color 0.24s var(--ease), border-color 0.24s var(--ease);
  }
  .faq[open] .faq__mark { transform: rotate(180deg); background: var(--ink); border-color: var(--ink); color: var(--on-ink); }

  .faq__a { padding: 0 0 1.4rem; max-width: 66ch; }
  .faq__a p { margin: 0; color: var(--text-2); font-size: 0.96rem; line-height: 1.72; }
  .faq[open] .faq__a { animation: faq-in 0.32s var(--ease-out); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>

---
import Picture from '~/components/Picture.astro';
import { t, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="section proc section--ink grain" aria-labelledby="proc-h">
  <div class="proc__media" aria-hidden="true">
    <Picture slug="craft-carpenter" lang={lang} sizes="100vw" class="proc__img" alt="" />
  </div>

  <div class="wrap proc__inner">
    <div class="section-head reveal">
      <p class="eyebrow">{d.process.eyebrow}</p>
      <h2 class="h2" id="proc-h">{d.process.heading}</h2>
    </div>

    <ol class="steps">
      {d.process.steps.map((s, i) => (
        <li class="step reveal" style={`--reveal-delay:${i * 90}ms`}>
          <span class="step__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="step__body">
            <h3 class="h4 step__t">{s.title}</h3>
            <p class="step__p">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc { position: relative; isolation: isolate; overflow: hidden; }
  .proc__media { position: absolute; inset: 0; z-index: -2; }
  .proc__media :global(.proc__img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.16; filter: grayscale(0.4); }
  .proc::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(115deg, var(--ink) 18%, rgba(18,23,28,.86) 55%, rgba(18,23,28,.7) 100%);
  }
  .proc__inner { position: relative; }

  .steps {
    display: grid; gap: 1px;
    grid-template-columns: 1fr;
    background: var(--line-ink);
    border: 1px solid var(--line-ink);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 680px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1140px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .step {
    background: var(--ink);
    padding: clamp(1.6rem, 3vw, 2.25rem) clamp(1.3rem, 2.4vw, 1.8rem);
    display: flex; flex-direction: column; gap: 1.1rem;
    position: relative;
    transition: background 0.35s var(--ease);
  }
  .step:hover { background: var(--ink-2); }
  .step::after {
    content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 2px;
    background: var(--brass-glow);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .step:hover::after { transform: scaleX(1); }

  .step__n {
    font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.14em; color: var(--brass-glow);
  }
  .step__t { color: #fff; }
  .step__p { margin: 0.55rem 0 0; color: var(--on-ink-2); font-size: 0.93rem; line-height: 1.68; }
</style>

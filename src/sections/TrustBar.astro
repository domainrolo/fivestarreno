---
import Icon from '~/components/Icon.astro';
import { t, type Lang } from '~/i18n';
import { site } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

/**
 * Only claims we can stand behind appear here. The credential badges below
 * stay out of the markup entirely until the matching value in src/data/site.ts
 * is filled in, so the page never asserts something unverified.
 */
const items: Array<{ icon: string; label: string }> = [
  { icon: 'ruler', label: d.trust.freeEstimate },
  { icon: 'layers', label: d.trust.writtenQuote },
  { icon: 'globe', label: d.trust.korean },
  { icon: 'pin', label: d.trust.gta },
];

if (site.warrantyYears) items.push({ icon: 'shield', label: d.trust.warranty(site.warrantyYears) });
if (site.wsibCovered) items.push({ icon: 'check', label: d.trust.wsib });
if (site.liabilityInsurance) items.push({ icon: 'shield', label: d.trust.insured(site.liabilityInsurance) });
if (site.googleRating && site.googleReviewCount) {
  items.push({ icon: 'star', label: d.trust.rating(site.googleRating, site.googleReviewCount) });
}

// The marquee needs the list twice so the loop has no visible seam.
const track = [...items, ...items];
---
<section class="trust" id="trust" aria-label={d.trust.freeEstimate}>
  <div class="marquee">
    <ul class="marquee__track">
      {track.map((it, i) => (
        <li class="trust__item" aria-hidden={i >= items.length ? 'true' : undefined}>
          <Icon name={it.icon} size={17} class="trust__icon" />
          <span>{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--ink-2); color: var(--on-ink);
    border-block: 1px solid var(--line-ink);
    overflow: hidden;
  }
  .marquee {
    display: flex; overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee__track {
    display: flex; flex: none; align-items: center;
    gap: clamp(1.75rem, 4vw, 3.25rem);
    padding: 0.95rem clamp(0.9rem, 2vw, 1.6rem);
    animation: slide 42s linear infinite;
  }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .trust__item {
    display: inline-flex; align-items: center; gap: 0.6rem;
    white-space: nowrap;
    font-size: 0.87rem; font-weight: 500; letter-spacing: 0.01em;
    color: var(--on-ink-2);
  }
  .trust__item :global(.trust__icon) { color: var(--brass-glow); flex: none; }

  /* Without motion the marquee becomes a plain wrapped list. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee__track {
      flex-wrap: wrap; justify-content: center; gap: 0.7rem 1.75rem;
      animation: none; padding-block: 1rem;
    }
    .trust__item[aria-hidden='true'] { display: none; }
  }
</style>

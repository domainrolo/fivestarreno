---
interface Props { class?: string; tone?: 'ink' | 'paper' }
const { class: className, tone = 'ink' } = Astro.props;
const fg = tone === 'paper' ? 'var(--on-ink)' : 'var(--text)';
---
<span class:list={['logo', className]} aria-hidden="true">
  <svg class="logo__mark" viewBox="0 0 32 32" fill="none" role="presentation">
    <path d="M16 2.6 19.9 11l9.1 1.1-6.7 6.3 1.8 9L16 23.1 7.9 27.4l1.8-9L3 12.1 12.1 11z"
          fill="var(--brass)"/>
    <path d="M9.5 20.6 16 17.2l6.5 3.4" stroke="var(--ink)" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>
  </svg>
  <span class="logo__text" style={`color:${fg}`}>
    <span class="logo__a">Five Star</span><span class="logo__b">Reno</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo__mark { width: 30px; height: 30px; flex: none; }
  .logo__text {
    display: flex; flex-direction: column; line-height: 1;
    font-family: var(--font-display); letter-spacing: -0.02em;
  }
  .logo__a { font-size: 1.12rem; font-weight: 700; }
  .logo__b {
    font-family: var(--font-body);
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.3em;
    text-transform: uppercase; opacity: 0.62; margin-top: 3px;
  }
  @media (max-width: 380px) { .logo__mark { width: 26px; height: 26px; } .logo__a { font-size: 1rem; } }
</style>

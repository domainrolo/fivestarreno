---
import Picture from './Picture.astro';
import { type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  eyebrow: string;
  heading: string;
  lead?: string;
  photo?: string;
}
const { lang, eyebrow, heading, lead, photo } = Astro.props;
---
<section class="phead on-ink grain">
  {photo && (
    <div class="phead__media" aria-hidden="true">
      <Picture slug={photo} lang={lang} sizes="100vw" class="phead__img" priority alt="" />
    </div>
  )}
  <div class="wrap phead__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="h1 phead__h">{heading}</h1>
    {lead && <p class="lead phead__lead">{lead}</p>}
  </div>
</section>

<style>
  .phead {
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--ink); color: var(--on-ink);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
  }
  .phead__media { position: absolute; inset: 0; z-index: -2; }
  .phead__media :global(.phead__img) { width: 100%; height: 100%; object-fit: cover; }
  .phead::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(105deg, rgba(12,16,20,.95) 20%, rgba(12,16,20,.78) 70%, rgba(12,16,20,.62) 100%);
  }
  .phead__inner { position: relative; max-width: 54rem; }
  .phead__h { color: #fff; animation: ph-in 0.7s var(--ease-out) backwards; }
  .phead__lead { color: rgba(251,249,246,.86); margin-top: 1.1rem; animation: ph-in 0.7s var(--ease-out) 0.1s backwards; }
  @keyframes ph-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .phead__h, .phead__lead { animation: none; } }
</style>

---
import Base from '~/layouts/Base.astro';
import Hero from '~/sections/Hero.astro';
import TrustBar from '~/sections/TrustBar.astro';
import Services from '~/sections/Services.astro';
import Stats from '~/sections/Stats.astro';
import Gallery from '~/sections/Gallery.astro';
import Process from '~/sections/Process.astro';
import Why from '~/sections/Why.astro';
import Testimonials from '~/sections/Testimonials.astro';
import Costs from '~/sections/Costs.astro';
import Areas from '~/sections/Areas.astro';
import Faq from '~/sections/Faq.astro';
import CtaBand from '~/sections/CtaBand.astro';
import { t, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base
  lang={lang}
  path="/"
  title={d.pages.home.title}
  description={d.pages.home.description}
  transparentHeader
>
  <Hero lang={lang} />
  <TrustBar lang={lang} />
  <Services lang={lang} limit={6} />
  <Gallery lang={lang} limit={12} showViewAll tone="paper2" />
  <Process lang={lang} />
  <Why lang={lang} />
  <Stats lang={lang} />
  <Testimonials lang={lang} />
  <Costs lang={lang} />
  <Areas lang={lang} />
  <Faq lang={lang} />
  <CtaBand lang={lang} />
</Base>

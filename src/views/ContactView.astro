---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import ContactForm from '~/sections/ContactForm.astro';
import Faq from '~/sections/Faq.astro';
import Areas from '~/sections/Areas.astro';
import { t, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} path="/contact" title={d.pages.contact.title} description={d.pages.contact.description}>
  <PageHead
    lang={lang}
    eyebrow={d.contact.eyebrow}
    heading={d.contact.heading}
    lead={d.contact.lead}
    photo="g-kitchen-marble"
  />
  <ContactForm lang={lang} />
  <Areas lang={lang} />
  <Faq lang={lang} />
</Base>
